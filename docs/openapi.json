          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-Service-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Token"
            }
          },
          {
            "name": "X-Owner-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "default_user",
              "title": "X-Owner-Id"
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
